<Project>
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
        <EnablePackageVersionOverride>false</EnablePackageVersionOverride>
    </PropertyGroup>
    <!-- Code renderer Package Versions -->
    <ItemGroup>
        <PackageVersion Include="Accord.Math" Version="3.8.0"/>
        <PackageVersion Include="CommandLineParser" Version="2.8.0"/>
        <PackageVersion Include="MongoDB.Bson" Version="3.4.0"/>
        <PackageVersion Include="MongoDB.Driver" Version="3.4.0"/>
        <PackageVersion Include="NConfiguration" Version="3.0"/>
        <PackageVersion Include="Newtonsoft.Json" Version="13.0.3"/>
        <PackageVersion Include="Ninject" Version="3.3"/>
        <PackageVersion Include="NLog" Version="5.5.0"/>
    </ItemGroup>
    <!-- Test Package Versions -->
    <ItemGroup>
        <PackageVersion Include="NUnit" Version="4.3.2"/>
        <PackageVersion Include="NUnit3TestAdapter" Version="5.0.0"/>

        <PackageVersion Include="xunit.v3" Version="2.0.3"/>
        <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.1"/>
        <PackageVersion Include="FluentAssertions" Version="7.0.0"/>
        <PackageVersion Include="Testcontainers" Version="4.5.0" />
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1"/>
    </ItemGroup>    
</Project>