<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net5.0</TargetFramework>
    <LangVersion>9</LangVersion>
    <OutputType>Exe</OutputType>
    <RootNamespace>ShardEqualizer</RootNamespace>
    <AssemblyName>ShardEqualizer</AssemblyName>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>SmartcatShardEqualizer</ToolCommandName>
    <Authors>Anatoliy Koperin &lt;a.koperin@gmail.com&gt;</Authors>
    <Description>Tool for aligning the size of stored data on shards in a MongoDB cluster</Description>
    <RepositoryUrl>http://gitlab.sc.local/commontools/forks/shardequalizer</RepositoryUrl>
    <PackageId>Smartcat.Fork.ShardEqualizer</PackageId>
    <PackageLicenseUrl>http://gitlab.sc.local/commontools/forks/shardequalizer/blob/develop/LICENSE.txt</PackageLicenseUrl>
    <PackageProjectUrl>http://gitlab.sc.local/commontools/forks/shardequalizer</PackageProjectUrl>
    <PackageTags>mongodb sharding</PackageTags>
    <AssemblyVersion>1.0.0</AssemblyVersion>
    <PackageVersion>1.0.0-beta-8-TECH-5558</PackageVersion>
    <InformationalVersion>1.0.0-beta-8-TECH-5558</InformationalVersion>
  </PropertyGroup>
  <ItemGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <None Update="NLog.config">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="configuration.sample.xml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="dev.xml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <Import Project="..\.paket\Paket.Restore.targets" />
</Project>
