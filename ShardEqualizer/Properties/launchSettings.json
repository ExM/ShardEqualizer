{
  "$schema": "https://json.schemastore.org/launchsettings.json",
  "profiles": {
    "help": {
      "commandName": "Project",
      "commandLineArgs": "help"
    },
    "version": {
      "commandName": "Project",
      "commandLineArgs": "version"
    },
    "config-init": {
      "commandName": "Project",
      "commandLineArgs": "config-init --config=newConfig.xml -h localhost:27034"
    },
    "config-update": {
      "commandName": "Project",
      "commandLineArgs": "config-update -c dev.xml"
    },
    "deviation": {
      "commandName": "Project",
      "commandLineArgs": "deviation -c dev.xml -sM --format=md --layouts=\"default,balance\""
    },
    "scan-jumbo": {
      "commandName": "Project",
      "commandLineArgs": "scan-jumbo -c dev.xml"
    },
    "equalize planOnly": {
      "commandName": "Project",
      "commandLineArgs": "equalize -c dev.xml --dry-run"
    },
    "equalize planOnly from cache": {
      "commandName": "Project",
      "commandLineArgs": "equalize -c dev.xml --dry-run --store-mode=rw"
    },
    "equalize": {
      "commandName": "Project",
      "commandLineArgs": "equalize -c dev.xml"
    },
    "equalize correctionPercent": {
      "commandName": "Project",
      "commandLineArgs": "equalize -c dev.xml --correction-percent=20"
    },
    "equalize limited": {
      "commandName": "Project",
      "commandLineArgs": "equalize -c dev.xml --move-limit=51200"
    },
    "equalize offline": {
      "commandName": "Project",
      "commandLineArgs": "equalize -c dev.xml --move-limit=200"
    },
    "merge": {
      "commandName": "Project",
      "commandLineArgs": "merge -c dev.xml"
    },
    "clear-jumbo": {
      "commandName": "Project",
      "commandLineArgs": "clear-jumbo -c dev.xml"
    },
    "presplit": {
      "commandName": "Project",
      "commandLineArgs": "presplit -c dev.xml"
    },
    "presplit renew": {
      "commandName": "Project",
      "commandLineArgs": "presplit -c dev.xml --renew"
    },
    "balancer": {
      "commandName": "Project",
      "commandLineArgs": "balancer -c dev.xml"
    },
    "clear-jumbo help": {
      "commandName": "Project",
      "commandLineArgs": "clear-jumbo --help"
    },
    "balancer help": {
      "commandName": "Project",
      "commandLineArgs": "balancer --help"
    },
    "presplit help": {
      "commandName": "Project",
      "commandLineArgs": "presplit --help"
    },
    "equalize help": {
      "commandName": "Project",
      "commandLineArgs": "equalize --help"
    },
    "deviation help": {
      "commandName": "Project",
      "commandLineArgs": "deviation --help"
    },
    "config-init help": {
      "commandName": "Project",
      "commandLineArgs": "config-init --help"
    }
  }
}
